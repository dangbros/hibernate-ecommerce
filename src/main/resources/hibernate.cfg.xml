<?xml version="1.0" encoding="UTF-8"?>
<hibernate-configuration>
	<session-factory>
		<!-- Database connection settings: driver, url, username, password -->
		<property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
		<property name="hibernate.connection.url">jdbc:mysql://localhost:3306/ecommerce_db</property>
		<property name="hibernate.connection.username">root</property>
		<property name="hibernate.connection.password">${DB_PASSWORD}</property>

		<!-- JDBC connection pool settings -->
		<property name="hibernate.connection.pool_size">5</property>

		<!-- Schema management: update creates missing tables/columns without dropping data -->
		<property name="hibernate.hbm2ddl.auto">update</property>

		<!-- SQL dialect for MySQL 8 -->
		<property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>

		<!-- Echo the SQL to stdout -->
		<property name="hibernate.show_sql">true</property>

		<!-- Thread-bound session context (used by getCurrentSession()) -->
		<property name="hibernate.current_session_context_class">thread</property>
	</session-factory>
</hibernate-configuration>
